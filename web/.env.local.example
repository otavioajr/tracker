# web/.env.local.example
# Copy to .env.local and fill in values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (direct connection for Drizzle)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Chave pública CARTO para as camadas Ruas/Escuro; exige novo build após alterar.
# Solicite em https://carto.com/basemaps/apikey/ e configure também na Vercel.
NEXT_PUBLIC_CARTO_API_KEY=

# Map rotation (0 = disabled, 1 = enabled)
NEXT_PUBLIC_ENABLE_MAP_ROTATION=0
