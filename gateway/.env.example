# gateway/.env.example
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
TCP_PORT=5001
# Prazo positivo entre mensagens completas; mantenha margem sobre o intervalo do aparelho.
# 10m tolera relatórios a cada 5m. Exige reinício do gateway após alteração.
IDLE_TIMEOUT=10m
METRICS_PORT=9090
DEVICE_RELOAD_INTERVAL=5s
# Legacy command endpoint stays private; non-loopback binding requires a token.
COMMAND_ADDR=127.0.0.1:9091
COMMAND_TOKEN=
